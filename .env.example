# Copy to .env.local for local dev. Values exposed to client; do NOT
# treat as secret. This is mock-grade auth for prototyping only.

# Supabase project URL (Settings → API → Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key (Settings → API → Project API keys → anon/public)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Optional super-admin bootstrap. If both phone and password are set
# and no admin exists yet, the app seeds a local admin account on first
# load. Sign in via /admin/login.
VITE_SUPERADMIN_PHONE=
VITE_SUPERADMIN_PASSWORD=
VITE_SUPERADMIN_USERNAME=superadmin
